build-cmake/
# The README's own build command is `cmake -S . -B build`, which fills this with
# a CMake cache, generated makefiles and the binary. `*.exe` in the root ignore
# file covered the binary but nothing else, so following the documented
# instructions left the tree dirty.
build/

# Benchmark corpus fetched by tools/fetch_corpus.py. Not distributed: it is a
# separate project under its own licence. See benchmarks/README.md.
benchmarks/corpus/

# Derived position sets. Rebuilt locally by tools/mint_eval_set.py, never
# committed: they are subsets of a separately-licensed corpus, and committing
# them would re-create the redistribution obligation their removal eliminated.
benchmarks/*.jsonl
